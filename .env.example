# --- VPS mode (set TARGET_URL to enable) ---

# Backend Xray/VLESS server base URL (http or https, no trailing slash)
TARGET_URL=http://YOUR_VPS_IP:YOUR_XRAY_PORT

# Public path prefix clients use (stripped before forwarding)
# Example: PUBLIC_RELAY_PATH=/api → client hits /api/foo → upstream gets /foo
PUBLIC_RELAY_PATH=

# Path prefix added on upstream side
# Example: UPSTREAM_PATH_PREFIX=/xhttp → client hits /foo → upstream gets /xhttp/foo
UPSTREAM_PATH_PREFIX=

# --- Auth (both modes) ---

# Optional shared secret. Clients must send: X-Relay-Key: YOUR_SECRET
# Leave unset to disable auth (open relay)
RELAY_KEY=

# --- Tuning ---

# Upstream fetch timeout in milliseconds (max 39000)
TIMEOUT_MS=30000
